# Database (Neon recommended for managed Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth
NEXTAUTH_URL=https://tenderim.example.com
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Anthropic (Claude — used for extraction passes 1-5)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (used for narrative AI improvement in the wizard)
OPENAI_API_KEY=sk-...

# Local file storage. In production, mount a volume here.
DATA_DIR=./data

# pdf-service URL (docker-compose sets this to http://pdf-service:8000)
PDF_SERVICE_URL=http://localhost:8000

# pg-boss schema (default 'pgboss')
PGBOSS_SCHEMA=pgboss

# Caddy domain (production only)
DOMAIN=tenderim.example.com

# Resend (transactional email — step-ready notifications)
RESEND_API_KEY=re_...
RESEND_FROM=Tenderim <noreply@viraly-ai.com>

# Pattern 3 autofill confidence threshold (0.0–1.0). Values >= this auto-fill;
# below this require user confirmation.
AUTOFILL_CONFIDENCE_THRESHOLD=0.85
